{
  "name": "qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.ts",
    "serve": "node scripts/serve.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:all": "playwright test",
    "check:links": "node scripts/check-links.ts",
    "fetch:repos": "node scripts/fetch-repos.ts",
    "quality:collect": "node scripts/collect-quality.ts",
    "lhci": "lhci autorun",
    "sync:ds": "node scripts/sync-design-system.ts",
    "deploy": "wrangler deploy",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:visual:update:linux": "docker run --rm -v \"$PWD\":/work -w /work --ipc=host mcr.microsoft.com/playwright:v1.65.0-noble sh -c \"corepack enable && pnpm install --frozen-lockfile && pnpm test:visual:update\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shikijs/rehype": "^3.23.0",
    "@shikijs/transformers": "^3.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.16.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
